# Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database Configuration (Supabase Session Pooler)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DB_POOL_MAX=2
DB_POOL_MIN=0
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Supabase TLS configuration (TLS certificate verification is enabled by default)
# Provide DB_CA_CERT_PATH if using custom trusted CA certificate bundle
# DB_CA_CERT_PATH=
DB_SSL_REJECT_UNAUTHORIZED=true

# Application Security
CORS_ORIGIN=http://localhost:5173
API_KEY=your_pipeline_ingestion_api_key_here
