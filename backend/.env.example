# Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devsecops_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# API Security & Ingestion
API_KEY=your_pipeline_ingestion_api_key_here
CORS_ORIGIN=http://localhost:5173

# Scanner Executable Overrides (optional, for local scanner runs)
SEMGREP_BIN=semgrep
TRIVY_BIN=trivy
